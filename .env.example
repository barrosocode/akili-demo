# Server-only (NUNCA NEXT_PUBLIC_)
LARAVEL_API_URL=http://localhost:8000/api/v1
LARAVEL_API_TIMEOUT_MS=30000

# Cookies
AUTH_COOKIE_NAME=akili_client_session
AUTH_REFRESH_COOKIE_NAME=akili_client_refresh
AUTH_ASSISTANCE_COOKIE_NAME=akili_assistance_session
AUTH_SUPPORT_COOKIE_NAME=akili_support_session
AUTH_SUPPORT_REFRESH_COOKIE_NAME=akili_support_refresh
# Secure=false só para HTTP local. Em staging/produção HTTPS: COOKIE_SECURE=true
# (aplica-se a sessão guardian, student, assistência e mesa de suporte — ADR-023).
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# App — portal do responsável/aluno em :3001; admin (escolas) em :3000
NEXT_PUBLIC_APP_NAME=Akili
NEXT_PUBLIC_APP_URL=http://localhost:3001
ADMIN_APP_URL=http://localhost:3000

# Handoff demo → painel admin ({url}/#demo_token=)
NEXT_PUBLIC_ADMIN_APP_URL=http://localhost:3000

# Painel "Acesso rápido para testes" em /signin e /aluno/entrar.
# true no demo. Omitir ou false em produção real.
# DEV_LOGIN_PANEL vale em runtime no servidor (basta reiniciar).
# NEXT_PUBLIC_DEV_LOGIN_PANEL é inlined no `next build`.
DEV_LOGIN_PANEL=false
NEXT_PUBLIC_DEV_LOGIN_PANEL=false

# Tawk.to (público — property/widget apenas; segredo fica só no Laravel).
# Sem NEXT_PUBLIC_: lidos no Server Component e injetados no TawkProvider.
TAWK_PROPERTY_ID=
TAWK_WIDGET_ID=
